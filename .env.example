# Copy to .env. Never commit real credentials.
SECRET_KEY=replace_with_random_secret_key
ADMIN_PASSWORD=replace_with_strong_admin_password
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_NAME=ClinicFlow Demo Clinic
DATABASE_PATH=clinicflow.db
# Set LIVE_MODE=true only after configuring integrations and consent
LIVE_MODE=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace_with_unique_verify_token
META_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=appointment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en_US
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
# Reminder schedule uses clinic local time; check every 5 minutes
